# Copiar a backend/.env y completar.

# API key de OpenRouter: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# live = llama al LLM · fake = opiniones heurísticas (sin key, para probar)
LLM_MODE=live

# Modelos free de OpenRouter (prefijo openrouter/ para LiteLLM).
# Nemotron Super para todos: los Gemma free suelen estar saturados (429) en origen.
SPECIALIST_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
COACH_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
# Si el principal falla (rate limit, modelo no disponible), se prueba este.
FALLBACK_MODEL=openrouter/google/gemma-4-31b-it:free

# Alternativa: Gemini directo (Google AI Studio, free tier).
# GEMINI_API_KEY=
# SPECIALIST_MODEL=gemini/gemini-flash-lite-latest
# COACH_MODEL=gemini/gemini-flash-latest

# Escenario con el que arranca el atleta: normal | fatigued | recovered
SCENARIO=normal
