# Copiar a backend/.env y completar.

# live = llama al LLM · fake = opiniones heurísticas (sin key, para probar)
LLM_MODE=live

# Principal: Gemini directo (Google AI Studio, free tier). https://aistudio.google.com/apikey
GEMINI_API_KEY=
SPECIALIST_MODEL=gemini/gemini-flash-lite-latest
COACH_MODEL=gemini/gemini-flash-latest

# Fallback: OpenRouter free (50 pedidos/día por cuenta). https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
FALLBACK_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# Escenario con el que arranca el atleta: normal | fatigued | recovered
SCENARIO=normal
